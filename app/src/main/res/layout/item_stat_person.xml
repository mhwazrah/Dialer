<?xml version="1.0" encoding="utf-8"?>
<!-- A most-called person: name and count over a bar showing their share against the top person -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/activity_margin"
    android:paddingVertical="@dimen/small_margin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.goodwy.commons.views.MyTextView
            android:id="@+id/person_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textSize="16sp"
            tools:text="Omar Saleh" />

        <com.goodwy.commons.views.MyTextView
            android:id="@+id/person_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/medium_margin"
            android:alpha="0.6"
            android:textSize="14sp"
            tools:text="26 calls · 18m 57s" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/person_share"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:max="100"
        android:importantForAccessibility="no"
        app:indicatorTrackGapSize="0dp"
        app:trackCornerRadius="3dp"
        app:trackStopIndicatorSize="0dp"
        app:trackThickness="6dp"
        xmlns:app="http://schemas.android.com/apk/res-auto" />
</LinearLayout>
