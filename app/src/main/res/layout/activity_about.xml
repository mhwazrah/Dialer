<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/about_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.goodwy.commons.views.MyAppBarLayout
        android:id="@+id/about_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/about_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/about"
            app:titleTextAppearance="@style/AppTheme.ActionBar.TitleTextStyle" />
    </com.goodwy.commons.views.MyAppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/about_nested_scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingHorizontal="@dimen/activity_padding_left_right"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/about_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/activity_margin"
                android:importantForAccessibility="no"
                android:src="@mipmap/ic_launcher" />

            <com.goodwy.commons.views.MyTextView
                android:id="@+id/about_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/medium_margin"
                android:text="@string/about_app_name"
                android:textSize="@dimen/big_text_size"
                android:textStyle="bold" />

            <com.goodwy.commons.views.MyTextView
                android:id="@+id/about_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:alpha="0.6" />

            <androidx.cardview.widget.CardView
                android:id="@+id/about_bio_card"
                style="@style/SettingsSectionHolder"
                android:layout_marginTop="@dimen/activity_margin"
                app:cardCornerRadius="@dimen/glass_card_radius"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/activity_margin">

                    <com.goodwy.commons.views.MyTextView
                        android:id="@+id/about_greeting"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/about_greeting"
                        android:textStyle="bold" />

                    <com.goodwy.commons.views.MyTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/medium_margin"
                        android:text="@string/about_bio" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/about_philosophy_label"
                style="@style/SettingsSectionLabelStyle"
                android:text="@string/about_philosophy_title" />

            <androidx.cardview.widget.CardView
                android:id="@+id/about_philosophy_card"
                style="@style/SettingsSectionHolder"
                app:cardCornerRadius="@dimen/glass_card_radius"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/activity_margin">

                    <com.goodwy.commons.views.MyTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/about_philosophy_1" />

                    <com.goodwy.commons.views.MyTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/medium_margin"
                        android:text="@string/about_philosophy_2" />

                    <com.goodwy.commons.views.MyTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/medium_margin"
                        android:text="@string/about_philosophy_3" />

                    <com.goodwy.commons.views.MyTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/medium_margin"
                        android:text="@string/about_philosophy_4" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <com.goodwy.commons.views.MyTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/medium_margin"
                android:layout_marginTop="@dimen/activity_margin"
                android:text="@string/about_goal"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/about_follow_label"
                style="@style/SettingsSectionLabelStyle"
                android:text="@string/about_follow_title" />

            <androidx.cardview.widget.CardView
                android:id="@+id/about_links_card"
                style="@style/SettingsSectionHolder"
                android:layout_marginBottom="@dimen/activity_margin"
                app:cardCornerRadius="@dimen/glass_card_radius"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:id="@+id/about_github_holder"
                        style="@style/SettingsHolderStyle">

                        <com.goodwy.commons.views.MyTextView
                            style="@style/SettingsTextLabelStyle"
                            android:layout_centerVertical="true"
                            android:text="@string/about_github" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/about_x_holder"
                        style="@style/SettingsHolderStyle">

                        <com.goodwy.commons.views.MyTextView
                            style="@style/SettingsTextLabelStyle"
                            android:layout_centerVertical="true"
                            android:text="@string/about_x" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/about_linkedin_holder"
                        style="@style/SettingsHolderStyle">

                        <com.goodwy.commons.views.MyTextView
                            style="@style/SettingsTextLabelStyle"
                            android:layout_centerVertical="true"
                            android:text="@string/about_linkedin" />
                    </RelativeLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
