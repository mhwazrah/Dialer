<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/stats_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.goodwy.commons.views.MyAppBarLayout
        android:id="@+id/stats_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/stats_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/call_statistics"
            app:titleTextAppearance="@style/AppTheme.ActionBar.TitleTextStyle" />
    </com.goodwy.commons.views.MyAppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/stats_scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingHorizontal="@dimen/activity_padding_left_right"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/stats_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/activity_margin">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/small_margin"
                android:gravity="center_horizontal"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/stats_period_week"
                    style="@style/StatsPeriodButton"
                    android:text="@string/stats_last_7_days" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/stats_period_month"
                    style="@style/StatsPeriodButton"
                    android:text="@string/stats_last_30_days" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/stats_period_all"
                    style="@style/StatsPeriodButton"
                    android:text="@string/stats_all_time" />
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/stats_summary_card"
                style="@style/SettingsSectionHolder"
                android:layout_marginTop="@dimen/activity_margin"
                app:cardCornerRadius="@dimen/glass_card_radius"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/activity_margin">

                    <com.goodwy.commons.views.MyTextView
                        android:id="@+id/stats_talk_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textSize="34sp"
                        android:textStyle="bold"
                        tools:text="5h 12m" />

                    <com.goodwy.commons.views.MyTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alpha="0.6"
                        android:gravity="center"
                        android:text="@string/stats_talk_time" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/activity_margin"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/stats_total"
                            layout="@layout/item_stat_tile" />

                        <include
                            android:id="@+id/stats_incoming"
                            layout="@layout/item_stat_tile" />

                        <include
                            android:id="@+id/stats_outgoing"
                            layout="@layout/item_stat_tile" />

                        <include
                            android:id="@+id/stats_missed"
                            layout="@layout/item_stat_tile" />
                    </LinearLayout>

                    <com.goodwy.commons.views.MyTextView
                        android:id="@+id/stats_average"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/activity_margin"
                        android:alpha="0.8"
                        android:gravity="center"
                        tools:text="Average call: 3m 20s" />

                    <com.goodwy.commons.views.MyTextView
                        android:id="@+id/stats_busiest_hour"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/small_margin"
                        android:alpha="0.8"
                        android:gravity="center"
                        tools:text="Busiest hour: 18:00" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/stats_top_label"
                style="@style/SettingsSectionLabelStyle"
                android:text="@string/stats_top_contacts" />

            <androidx.cardview.widget.CardView
                android:id="@+id/stats_top_card"
                style="@style/SettingsSectionHolder"
                app:cardCornerRadius="@dimen/glass_card_radius"
                app:cardElevation="0dp">

                <LinearLayout
                    android:id="@+id/stats_top_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/small_margin" />
            </androidx.cardview.widget.CardView>

            <com.goodwy.commons.views.MyTextView
                android:id="@+id/stats_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/activity_margin"
                android:alpha="0.6"
                android:gravity="center"
                android:text="@string/stats_no_calls"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
