<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.goodwy.commons.views.MyAppBarLayout
        android:id="@+id/settings_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/settings_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:menu="@menu/menu_settings"
            app:title="@string/settings"
            app:titleTextAppearance="@style/AppTheme.ActionBar.TitleTextStyle" />
    </com.goodwy.commons.views.MyAppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/settingsNestedScrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/activity_padding_left_right"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/settings_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/settings_appearance_label"
                style="@style/SettingsSectionLabelStyle"
                android:layout_marginTop="12dp"
                android:text="@string/pref_category_appearance"
                tools:textColor="@color/primary"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/settingsColorCustomizationHolder"
                style="@style/SettingsSectionHolder"
                app:cardCornerRadius="@dimen/glass_card_radius"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:id="@+id/settings_theme_holder"
                        style="@style/SettingsHolderStyle">

                        <com.goodwy.commons.views.MyTextView
                            android:id="@+id/settings_theme_label"
                            style="@style/SettingsTextLabelStyle"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:layout_toStartOf="@+id/settings_theme"
                            android:text="@string/settings_theme"/>

                        <com.goodwy.commons.views.MyTextView
                            android:id="@+id/settings_theme"
                            style="@style/SettingsTextValueStyle"
                            android:layout_alignParentEnd="true"
                            android:layout_marginEnd="@dimen/settings_margin"
                            tools:text="System default"/>
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/settings_color_sim_card_icons_holder"
                        style="@style/SettingsHolderSwitchStyle">

                        <com.goodwy.commons.views.MyMaterialSwitch
                            android:id="@+id/settings_color_sim_card_icons"
                            style="@style/SettingsSwitchStyle"
                            android:text="@string/color_sim_card_icons"
                            app:switchPadding="@dimen/bigger_margin"/>
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/settingsSimCardColor1Holder"
                        style="@style/SettingsHolderStyle"
                        android:padding="@dimen/smaller_margin">

                        <com.goodwy.commons.views.MyTextView
                            android:id="@+id/settingsSimCardColor1Label"
                            style="@style/SettingsTextLabelStyle"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:layout_toStartOf="@+id/settingsSimCardColor1Icon"
                            android:text="@string/button_primary"/>

                        <ImageView
                            android:id="@+id/settingsSimCardColor1Icon"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="@dimen/settings_margin"
                            android:padding="@dimen/smaller_margin"
                            android:background="@drawable/pulsing_background"
                            android:foreground="@drawable/ripple_all_corners_56dp"
                            android:contentDescription="@string/contact_color_list"
                            android:src="@drawable/ic_phone_vector"
                            tools:backgroundTint="@color/ic_dialer"
                            tools:tint="@color/white"/>
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/settingsSimCardColor2Holder"
                        style="@style/SettingsHolderStyle"
                        android:padding="@dimen/smaller_margin">

                        <com.goodwy.commons.views.MyTextView
                            android:id="@+id/settingsSimCardColor2Label"
                            style="@style/SettingsTextLabelStyle"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:layout_toStartOf="@+id/settingsSimCardColor2Icon"
                            android:text="@string/button_secondary"/>

                        <ImageView
                            android:id="@+id/settingsSimCardColor2Icon"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="@dimen/settings_margin"
                            android:padding="@dimen/smaller_margin"
                            android:background="@drawable/pulsing_background"
                            android:foreground="@drawable/ripple_all_corners_56dp"
                            android:contentDescription="@string/contact_color_list"
                            android:src="@drawable/ic_phone_two_vector"
                            tools:backgroundTint="@color/color_primary"
                            tools:tint="@color/white"/>
                    </RelativeLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/settingsGeneralLabel"
                style="@style/SettingsSectionLabelStyle"
                android:text="@string/general"
                tools:textColor="@color/primary"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/settingsGeneralHolder"
                style="@style/SettingsSectionHolder"
                app:cardCornerRadius="@dimen/glass_card_radius"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:id="@+id/settingsManageBlockedNumbersHolder"
                        style="@style/SettingsHolderStyle">

                        <com.goodwy.commons.views.MyTextView
                            style="@style/SettingsTextLabelStyle"
                            android:layout_centerVertical="true"
                            android:layout_alignParentStart="true"
                            android:layout_toStartOf="@+id/settingsManageBlockedNumbersIconUnknown"
                            android:layout_marginEnd="12dp"
                            android:text="@string/manage_blocked_numbers"/>

                        <ImageView
                            android:id="@+id/settingsManageBlockedNumbersIconUnknown"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_centerVertical="true"
                            android:layout_toStartOf="@+id/settingsManageBlockedNumbersIconHidden"
                            android:layout_marginBottom="@dimen/tiny_margin"
                            android:layout_marginEnd="@dimen/smaller_margin"
                            android:src="@drawable/ic_no_accounts"
                            android:contentDescription="@string/block_unknown_calls"/>

                        <ImageView
                            android:id="@+id/settingsManageBlockedNumbersIconHidden"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_centerVertical="true"
                            android:layout_toStartOf="@+id/settingsManageBlockedNumbersCount"
                            android:layout_marginEnd="@dimen/medium_margin"
                            android:src="@drawable/ic_question"
                            android:contentDescription="@string/block_hidden_calls"/>

                        <com.goodwy.commons.views.MyTextView
                            android:id="@+id/settingsManageBlockedNumbersCount"
                            style="@style/SettingsTextValueStyle"
                            android:layout_centerVertical="true"
                            android:layout_toStartOf="@+id/settingsManageBlockedNumbersChevron"
                            android:layout_marginEnd="@dimen/tiny_margin"
                            tools:text="8"/>

                        <ImageView
                            android:id="@+id/settingsManageBlockedNumbersChevron"
                            style="@style/SettingsChevronStyle"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:contentDescription="@string/manage_blocked_numbers"/>
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/settings_change_date_time_format_holder"
                        style="@style/SettingsHolderStyle">

                        <com.goodwy.commons.views.MyTextView
                            android:id="@+id/settings_change_date_time_format_label"
                            style="@style/SettingsTextLabelStyle"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:layout_toStartOf="@+id/settings_change_date_time_format"
                            android:text="@string/change_date_and_time_format" />

                        <com.goodwy.commons.views.MyTextView
                            android:id="@+id/settings_change_date_time_format"
                            style="@style/SettingsTextValueStyle"
                            android:maxWidth="@dimen/settings_value_width_long"
                            android:layout_marginStart="@dimen/settings_margin"
                            android:layout_alignParentEnd="true"
                            android:layout_marginEnd="@dimen/settings_margin"
                            tools:text="01.01.2025 08:30" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/settings_language_holder"
                        style="@style/SettingsHolderStyle">

                        <com.goodwy.commons.views.MyTextView
                            android:id="@+id/settings_language_label"
                            style="@style/SettingsTextLabelStyle"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:layout_toStartOf="@+id/settings_language"
                            android:text="@string/language"/>

                        <com.goodwy.commons.views.MyTextView
                            android:id="@+id/settings_language"
                            style="@style/SettingsTextValueStyle"
                            android:layout_alignParentEnd="true"
                            android:layout_marginEnd="@dimen/settings_margin"
                            tools:text="English"/>
                    </RelativeLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/settingsTabsLabel"
                style="@style/SettingsSectionLabelStyle"
                android:text="@string/tabs"
                tools:textColor="@color/primary"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/settingsTabsHolder"
                style="@style/SettingsSectionHolder"
                app:cardCornerRadius="@dimen/glass_card_radius"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:id="@+id/settings_default_tab_holder"
                        style="@style/SettingsHolderStyle">

                        <com.goodwy.commons.views.MyTextView
                            android:id="@+id/settings_default_tab_label"
                            style="@style/SettingsTextLabelStyle"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:layout_toStartOf="@+id/settings_default_tab"
                            android:text="@string/default_tab"/>

                        <com.goodwy.commons.views.MyTextView
                            android:id="@+id/settings_default_tab"
                            style="@style/SettingsTextValueStyle"
                            android:layout_alignParentEnd="true"
                            android:layout_marginEnd="@dimen/settings_margin"
                            tools:text="Last used one"/>
                    </RelativeLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/settingsSwipeGesturesLabel"
                style="@style/SettingsSectionLabelStyle"
                android:text="@string/swipe_gestures_and_actions"
                tools:textColor="@color/primary"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/settingsSwipeGesturesHolder"
                style="@style/SettingsSectionHolder"
                app:cardCornerRadius="@dimen/glass_card_radius"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:id="@+id/settingsSwipeRightActionHolder"
                        style="@style/SettingsHolderSwitchStyle">

                        <com.goodwy.commons.views.MyTextView
                            android:id="@+id/settingsSwipeRightActionLabel"
                            style="@style/SettingsTextLabelStyle"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:layout_toStartOf="@+id/settingsSwipeRightAction"
                            android:text="@string/swipe_right_action" />

                        <com.goodwy.commons.views.MyTextView
                            android:id="@+id/settingsSwipeRightAction"
                            style="@style/SettingsTextValueStyle"
                            android:layout_alignParentEnd="true"
                            android:layout_marginEnd="@dimen/settings_margin"
                            tools:text="@string/send_sms" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/settingsSwipeLeftActionHolder"
                        style="@style/SettingsHolderSwitchStyle">

                        <com.goodwy.commons.views.MyTextView
                            android:id="@+id/settingsSwipeLeftActionLabel"
                            style="@style/SettingsTextLabelStyle"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:layout_toStartOf="@+id/settingsSwipeLeftAction"
                            android:text="@string/swipe_left_action" />

                        <com.goodwy.commons.views.MyTextView
                            android:id="@+id/settingsSwipeLeftAction"
                            style="@style/SettingsTextValueStyle"
                            android:layout_alignParentEnd="true"
                            android:layout_marginEnd="@dimen/settings_margin"
                            tools:text="@string/delete" />
                    </RelativeLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/settingsDialpadLabel"
                style="@style/SettingsSectionLabelStyle"
                android:text="@string/dialpad"
                tools:textColor="@color/primary"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/settingsDialpadHolder"
                style="@style/SettingsSectionHolder"
                app:cardCornerRadius="@dimen/glass_card_radius"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:id="@+id/settings_manage_speed_dial_holder"
                        style="@style/SettingsHolderStyle">

                        <com.goodwy.commons.views.MyTextView
                            android:id="@+id/settings_manage_speed_dial"
                            style="@style/SettingsTextLabelStyle"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="68dp"
                            android:text="@string/manage_speed_dial"/>

                        <ImageView
                            android:id="@+id/settings_manage_speed_dial_chevron"
                            style="@style/SettingsChevronStyle"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:contentDescription="@string/manage_speed_dial"/>
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/settings_dialpad_style_holder"
                        style="@style/SettingsHolderStyle">

                        <com.goodwy.commons.views.MyTextView
                            android:id="@+id/settings_dialpad_style_label"
                            style="@style/SettingsTextLabelStyle"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="68dp"
                            android:text="@string/dialpad_preferences"/>

                        <ImageView
                            android:id="@+id/settings_dialpad_style_chevron"
                            style="@style/SettingsChevronStyle"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:contentDescription="@string/dialpad_preferences"/>
                    </RelativeLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/settingsNotificationsLabel"
                style="@style/SettingsSectionLabelStyle"
                android:text="@string/notifications"
                tools:textColor="@color/primary"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/settingsNotificationsHolder"
                style="@style/SettingsSectionHolder"
                app:cardCornerRadius="@dimen/glass_card_radius"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:id="@+id/settingsFlashForAlertsHolder"
                        style="@style/SettingsHolderSwitchStyle">

                        <com.goodwy.commons.views.MyMaterialSwitch
                            android:id="@+id/settingsFlashForAlerts"
                            style="@style/SettingsSwitchStyle"
                            android:text="@string/flash_for_alerts"
                            app:switchPadding="@dimen/bigger_margin"/>
                    </RelativeLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/settingsCallsLabel"
                style="@style/SettingsSectionLabelStyle"
                android:text="@string/calls"
                tools:textColor="@color/primary"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/settingsCallsHolder"
                style="@style/SettingsSectionHolder"
                app:cardCornerRadius="@dimen/glass_card_radius"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:id="@+id/settings_always_show_fullscreen_holder"
                        style="@style/SettingsHolderSwitchStyle">

                        <com.goodwy.commons.views.MyMaterialSwitch
                            android:id="@+id/settings_always_show_fullscreen"
                            style="@style/SettingsSwitchStyle"
                            android:text="@string/show_incoming_calls_full_screen"
                            app:switchPadding="@dimen/bigger_margin"/>
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/settingsQuickAnswersHolder"
                        style="@style/SettingsHolderStyle">

                        <com.goodwy.commons.views.MyTextView
                            android:id="@+id/settingsQuickAnswersLabel"
                            style="@style/SettingsTextLabelStyle"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:layout_toStartOf="@+id/settingsQuickAnswersCount"
                            android:text="@string/quick_answers"/>

                        <com.goodwy.commons.views.MyTextView
                            android:id="@+id/settingsQuickAnswersCount"
                            style="@style/SettingsTextValueStyle"
                            android:layout_alignParentEnd="true"
                            android:layout_marginEnd="@dimen/settings_margin"
                            tools:text="3"/>
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/settings_disable_proximity_sensor_holder"
                        style="@style/SettingsHolderSwitchStyle">

                        <com.goodwy.commons.views.MyMaterialSwitch
                            android:id="@+id/settings_disable_proximity_sensor"
                            style="@style/SettingsSwitchStyle"
                            android:text="@string/disable_proximity_sensor"
                            app:switchPadding="@dimen/bigger_margin"/>
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/settings_flip_to_silence_holder"
                        style="@style/SettingsHolderSwitchStyle">

                        <com.goodwy.commons.views.MyMaterialSwitch
                            android:id="@+id/settings_flip_to_silence"
                            style="@style/SettingsSwitchStyle"
                            android:text="@string/flip_to_silence"
                            app:switchPadding="@dimen/bigger_margin"/>
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/settings_announce_caller_name_holder"
                        style="@style/SettingsHolderSwitchStyle">

                        <com.goodwy.commons.views.MyMaterialSwitch
                            android:id="@+id/settings_announce_caller_name"
                            style="@style/SettingsSwitchStyle"
                            android:text="@string/announce_caller_name"
                            app:switchPadding="@dimen/bigger_margin"/>
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/settings_announce_only_with_headset_holder"
                        style="@style/SettingsHolderSwitchStyle">

                        <com.goodwy.commons.views.MyMaterialSwitch
                            android:id="@+id/settings_announce_only_with_headset"
                            style="@style/SettingsSwitchStyle"
                            android:text="@string/announce_only_with_headset"
                            app:switchPadding="@dimen/bigger_margin"/>
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/settingsCallVibrationHolder"
                        style="@style/SettingsHolderSwitchStyle">

                        <com.goodwy.commons.views.MyMaterialSwitch
                            android:id="@+id/settingsCallVibration"
                            style="@style/SettingsSwitchStyle"
                            android:text="@string/vibrate_on_button_press"
                            app:switchPadding="@dimen/bigger_margin"/>
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/settingsCallStartEndVibrationHolder"
                        style="@style/SettingsHolderSwitchStyle">

                        <com.goodwy.commons.views.MyMaterialSwitch
                            android:id="@+id/settingsCallStartEndVibration"
                            style="@style/SettingsSwitchStyle"
                            android:text="@string/call_start_end_vibration"
                            app:switchPadding="@dimen/bigger_margin"/>
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/settings_dialpad_beeps_holder"
                        style="@style/SettingsHolderSwitchStyle"
                        android:visibility="gone">

                        <com.goodwy.commons.views.MyMaterialSwitch
                            android:id="@+id/settings_dialpad_beeps"
                            style="@style/SettingsSwitchStyle"
                            android:text="@string/dialpad_beeps"
                            app:switchPadding="@dimen/bigger_margin"/>
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/settings_show_call_confirmation_holder"
                        style="@style/SettingsHolderSwitchStyle">

                        <com.goodwy.commons.views.MyMaterialSwitch
                            android:id="@+id/settings_show_call_confirmation"
                            style="@style/SettingsSwitchStyle"
                            android:text="@string/show_call_confirmation_dialog"
                            app:switchPadding="@dimen/bigger_margin"/>
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/settingsCallFromSameSimHolder"
                        style="@style/SettingsHolderSwitchStyle">

                        <com.goodwy.commons.views.MyMaterialSwitch
                            android:id="@+id/settingsCallFromSameSim"
                            style="@style/SettingsSwitchStyle"
                            android:text="@string/call_using_same_sim"
                            app:switchPadding="@dimen/bigger_margin"/>
                    </RelativeLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/settingsListViewLabel"
                style="@style/SettingsSectionLabelStyle"
                android:text="@string/list_view"
                tools:textColor="@color/primary"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/settingsListViewHolder"
                style="@style/SettingsSectionHolder"
                app:cardCornerRadius="@dimen/glass_card_radius"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:id="@+id/settings_start_name_with_surname_holder"
                        style="@style/SettingsHolderSwitchStyle">

                        <com.goodwy.commons.views.MyMaterialSwitch
                            android:id="@+id/settings_start_name_with_surname"
                            style="@style/SettingsSwitchStyle"
                            android:text="@string/start_name_with_surname"
                            app:switchPadding="@dimen/bigger_margin"/>
                    </RelativeLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/settingsBackupsLabel"
                style="@style/SettingsSectionLabelStyle"
                android:text="@string/backups"
                tools:textColor="@color/primary"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/settingsBackupsHolder"
                style="@style/SettingsSectionHolder"
                app:cardCornerRadius="@dimen/glass_card_radius"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:id="@+id/settings_export_calls_holder"
                        style="@style/SettingsHolderStyle">

                        <com.goodwy.commons.views.MyTextView
                            android:id="@+id/settings_export_calls"
                            style="@style/SettingsTextLabelStyle"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="68dp"
                            android:text="@string/export_settings"/>

                        <ImageView
                            android:id="@+id/settings_export_calls_chevron"
                            style="@style/SettingsChevronStyle"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:contentDescription="@string/export_settings"/>
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/settings_import_calls_holder"
                        style="@style/SettingsHolderStyle">

                        <com.goodwy.commons.views.MyTextView
                            android:id="@+id/settings_import_calls"
                            style="@style/SettingsTextLabelStyle"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="68dp"
                            android:text="@string/import_settings"/>

                        <ImageView
                            android:id="@+id/settings_import_calls_chevron"
                            style="@style/SettingsChevronStyle"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:contentDescription="@string/import_settings"/>
                    </RelativeLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/settingsOtherLabel"
                style="@style/SettingsSectionLabelStyle"
                android:text="@string/other"
                tools:textColor="@color/primary"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/settingsOtherHolder"
                style="@style/SettingsSectionHolder"
                android:layout_marginBottom="@dimen/secondary_fab_bottom_margin"
                app:cardCornerRadius="@dimen/glass_card_radius"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:id="@+id/settings_about_holder"
                        style="@style/SettingsHolderStyle">

                        <com.goodwy.commons.views.MyTextView
                            android:id="@+id/settings_about_label"
                            style="@style/SettingsTextLabelStyle"
                            android:layout_centerVertical="true"
                            android:layout_alignParentStart="true"
                            android:layout_toStartOf="@+id/settings_about_version"
                            android:layout_marginEnd="@dimen/larger_margin"
                            android:text="@string/about"/>

                        <com.goodwy.commons.views.MyTextView
                            android:id="@+id/settings_about_version"
                            style="@style/SettingsTextValueStyle"
                            android:maxWidth="@dimen/settings_value_width_long"
                            android:layout_toStartOf="@+id/settingsAboutChevron"
                            android:layout_centerVertical="true"
                            tools:text="Version: 1.0.0"/>

                        <ImageView
                            android:id="@+id/settingsAboutChevron"
