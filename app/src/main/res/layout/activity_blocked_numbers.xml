<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/blocked_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.goodwy.commons.views.MyAppBarLayout
        android:id="@+id/blocked_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/blocked_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/blocked_numbers"
            app:titleTextAppearance="@style/AppTheme.ActionBar.TitleTextStyle" />
    </com.goodwy.commons.views.MyAppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/blocked_nested_scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingHorizontal="@dimen/activity_padding_left_right"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/blocked_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:id="@+id/blocked_switches_card"
                style="@style/SettingsSectionHolder"
                android:layout_marginTop="@dimen/activity_margin"
                app:cardCornerRadius="@dimen/glass_card_radius"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:id="@+id/blocked_enable_holder"
                        style="@style/SettingsHolderSwitchStyle">

                        <com.goodwy.commons.views.MyMaterialSwitch
                            android:id="@+id/blocked_enable"
                            style="@style/SettingsSwitchStyle"
                            android:text="@string/block_numbers"
                            app:switchPadding="@dimen/bigger_margin" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/blocked_unknown_holder"
                        style="@style/SettingsHolderSwitchStyle">

                        <com.goodwy.commons.views.MyMaterialSwitch
                            android:id="@+id/blocked_unknown"
                            style="@style/SettingsSwitchStyle"
                            android:text="@string/block_unknown_calls"
                            app:switchPadding="@dimen/bigger_margin" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/blocked_hidden_holder"
                        style="@style/SettingsHolderSwitchStyle">

                        <com.goodwy.commons.views.MyMaterialSwitch
                            android:id="@+id/blocked_hidden"
                            style="@style/SettingsSwitchStyle"
                            android:text="@string/block_hidden_calls"
                            app:switchPadding="@dimen/bigger_margin" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/blocked_skip_contacts_holder"
                        style="@style/SettingsHolderSwitchStyle">

                        <com.goodwy.commons.views.MyMaterialSwitch
                            android:id="@+id/blocked_skip_contacts"
                            style="@style/SettingsSwitchStyle"
                            android:text="@string/is_do_not_block_contacts_and_recent"
                            app:switchPadding="@dimen/bigger_margin" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/blocked_type_holder"
                        style="@style/SettingsHolderStyle">

                        <com.goodwy.commons.views.MyTextView
                            android:id="@+id/blocked_type_label"
                            style="@style/SettingsTextLabelStyle"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:layout_toStartOf="@+id/blocked_type"
                            android:text="@string/blocking_type" />

                        <com.goodwy.commons.views.MyTextView
                            android:id="@+id/blocked_type"
                            style="@style/SettingsTextValueStyle"
                            android:layout_alignParentEnd="true"
                            android:layout_marginEnd="@dimen/settings_margin" />
                    </RelativeLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/blocked_list_label"
                style="@style/SettingsSectionLabelStyle"
                android:text="@string/blocked_numbers" />

            <androidx.cardview.widget.CardView
                android:id="@+id/blocked_list_card"
                style="@style/SettingsSectionHolder"
                android:layout_marginBottom="@dimen/activity_margin"
                app:cardCornerRadius="@dimen/glass_card_radius"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:id="@+id/blocked_add_holder"
                        style="@style/SettingsHolderStyle">

                        <ImageView
                            android:id="@+id/blocked_add_icon"
                            android:layout_width="@dimen/normal_icon_size"
                            android:layout_height="@dimen/normal_icon_size"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_plus_vector" />

                        <com.goodwy.commons.views.MyTextView
                            style="@style/SettingsTextLabelStyle"
                            android:layout_centerVertical="true"
                            android:layout_toStartOf="@+id/blocked_add_icon"
                            android:text="@string/add_a_blocked_number" />
                    </RelativeLayout>

                    <LinearLayout
                        android:id="@+id/blocked_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <RelativeLayout
                        android:id="@+id/blocked_export_holder"
                        style="@style/SettingsHolderStyle">

                        <com.goodwy.commons.views.MyTextView
                            style="@style/SettingsTextLabelStyle"
                            android:layout_centerVertical="true"
                            android:text="@string/export_blocked_numbers" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/blocked_import_holder"
                        style="@style/SettingsHolderStyle">

                        <com.goodwy.commons.views.MyTextView
                            style="@style/SettingsTextLabelStyle"
                            android:layout_centerVertical="true"
                            android:text="@string/import_blocked_numbers" />
                    </RelativeLayout>

                    <com.goodwy.commons.views.MyTextView
                        android:id="@+id/blocked_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alpha="0.6"
                        android:gravity="center"
                        android:padding="@dimen/activity_margin"
                        android:text="@string/not_blocking_anyone"
                        android:visibility="gone" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
