<?xml version="1.0" encoding="utf-8"?>
<!-- A blocked number: avatar, contact name (when saved) over the number, and a compact unblock button -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/ListRowStyle"
    android:background="@null">

    <ImageView
        android:id="@+id/blocked_number_avatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.goodwy.commons.views.MyTextView
            android:id="@+id/blocked_number_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textSize="@dimen/bigger_text_size"
            android:visibility="gone" />

        <!-- Left to right, so "+966 …" never reorders in Arabic -->
        <com.goodwy.commons.views.MyTextView
            android:id="@+id/blocked_number_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textDirection="ltr"
            android:textSize="@dimen/bigger_text_size" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/blocked_number_delete"
        style="@style/ListRowActionButton"
        android:contentDescription="@string/unblock"
        android:src="@drawable/ic_delete_outline" />
</LinearLayout>
