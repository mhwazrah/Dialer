<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/SettingsHolderStyle">

    <ImageView
        android:id="@+id/blocked_number_delete"
        android:layout_width="@dimen/normal_icon_size"
        android:layout_height="@dimen/normal_icon_size"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:contentDescription="@string/unblock"
        android:src="@drawable/ic_delete_outline" />

    <!-- Contact name (hidden for numbers not in the phone's contacts), then the blocked number -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@+id/blocked_number_delete"
        android:orientation="vertical">

        <com.goodwy.commons.views.MyTextView
            android:id="@+id/blocked_number_name"
            style="@style/SettingsTextLabelStyle"
            android:visibility="gone" />

        <com.goodwy.commons.views.MyTextView
            android:id="@+id/blocked_number_text"
            style="@style/SettingsTextLabelStyle"
            android:textAlignment="viewStart"
            android:textDirection="firstStrongLtr" />
    </LinearLayout>
</RelativeLayout>
