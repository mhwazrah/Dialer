<?xml version="1.0" encoding="utf-8"?>
<!-- Dark-theme glass row/card: deep navy frost (rows read darker than the backdrop), a faint top
     sheen and a soft hairline rim. Loaded via the app-theme night mode set in SimpleActivity. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="@dimen/glass_card_radius" />
            <solid android:color="#D9000A18" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/glass_card_radius" />
            <gradient
                android:angle="270"
                android:centerY="0.35"
                android:startColor="#14FFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/glass_card_radius" />
            <stroke
                android:width="1dp"
                android:color="#26FFFFFF" />
        </shape>
    </item>
</layer-list>
