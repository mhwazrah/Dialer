<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ripple_foreground">#33FFFFFF</color>
    <color name="green_call">#FF67CE67</color>
    <color name="red_call">#FFEB5545</color>
    <color name="swipe_purple">#FF5E5CE6</color>
    <color name="whatsapp_green">#FF25D366</color>
    <color name="default_call_background">#FF001123</color>
    <color name="notification_icon">@color/dark_grey</color>
    <!-- Brand primary; overrides the commons default used when the user hasn't picked a colour. -->
    <color name="default_primary_color">#FF001E3C</color>
    <!-- Brand primary on dark themes (navy is invisible on the dark backdrop) -->
    <color name="brand_primary_dark_theme">#FF7FB2E5</color>
    <!-- Brand accent pair: teal on light themes, lighter teal on dark ones -->
    <color name="brand_accent">#FF00897B</color>
    <color name="brand_accent_dark_theme">#FF4DB6AC</color>
    <!-- Liquid Glass search field (inset pill inside the glass top bar) -->
    <color name="glass_search_fill_light">#0F001E3C</color>
    <color name="glass_search_rim_light">#1A001E3C</color>
    <color name="glass_search_fill_dark">#1FFFFFFF</color>
    <color name="glass_search_rim_dark">#2EFFFFFF</color>
    <color name="glass_search_text_light">#FF0B1B2B</color>
    <color name="glass_search_hint_light">#FF5A6B7D</color>
    <color name="glass_search_icon_light">#B3001E3C</color>
    <color name="glass_search_cursor_light">#FF001E3C</color>
    <color name="glass_search_text_dark">#FFF2F6FA</color>
    <color name="glass_search_hint_dark">#FF9FB0C2</color>
    <color name="glass_search_icon_dark">#BFFFFFFF</color>
    <color name="glass_search_cursor_dark">#FF8CC4FF</color>
    <!-- Ongoing-call notification buttons when not active (follows the system light/dark notification) -->
    <color name="notification_action_idle_fill">#1F000000</color>
    <color name="notification_action_idle_icon">#DE000000</color>

    <!-- Confirmation dialogs: the library colours button text with the app's primary colour, so the confirm button is a
         soft fill and cancel a hairline outline. One neutral grey for both themes: the dialog sheet follows the app theme
         while the always-dark call screens load night resources, so a night variant would land on a light sheet. -->
    <color name="dialog_button_tonal">#29808C99</color>
    <color name="dialog_button_outline">#73808C99</color>
</resources>
