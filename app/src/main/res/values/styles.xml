<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="AppTheme" parent="AppTheme.Base" />

    <!-- Overrides the library's base of the theme it applies at runtime (AppTheme.Blue_600_core): the same items, plus the
         app's confirmation-dialog theme. Keep in step with the library's definition when it is updated. -->
    <style name="AppTheme.Base.Core" parent="Theme.Material3.Dark.NoActionBar" tools:ignore="UnusedResources">
        <item name="android:colorControlHighlight">@color/activated_item_foreground</item>
        <item name="colorControlHighlight">@color/activated_item_foreground</item>
        <item name="bottomSheetDialogTheme">@style/BottomSheetDialogTheme</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="actionModeStyle">@style/AppCompat.ActionMode</item>
        <item name="actionOverflowMenuStyle">@style/TopPopupMenu.Overflow.Dark</item>
        <item name="android:actionOverflowButtonStyle">@style/ActionMenuOverflowIcon</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.MHW.AlertDialog</item>
    </style>

    <!-- Every confirmation dialog (built by the library with AlertDialog.Builder): pill buttons, confirm filled, cancel
         outlined; the library sets their text colour to the primary colour in code -->
    <style name="ThemeOverlay.MHW.AlertDialog" parent="ThemeOverlay.Material3.Dialog.Alert" tools:ignore="UnusedResources">
        <item name="buttonBarPositiveButtonStyle">@style/DialogConfirmButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogCancelButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/DialogCancelButton</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/DialogConfirmButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/DialogCancelButton</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/DialogCancelButton</item>
        <item name="android:backgroundDimAmount">0.5</item>
        <item name="buttonBarStyle">@style/DialogButtonBar</item>
        <item name="android:buttonBarStyle">@style/DialogButtonBar</item>
    </style>

    <style name="DialogButtonBar" parent="Widget.AppCompat.ButtonBar.AlertDialog">
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">20dp</item>
    </style>

    <style name="DialogCancelButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <!-- Narrow enough that three buttons stay on one row on a 360dp phone; the top margin spaces them if they stack -->
        <item name="android:minWidth">72dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/btn_dialog_outline</item>
    </style>

    <style name="DialogConfirmButton" parent="DialogCancelButton">
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/btn_dialog_tonal</item>
    </style>

    <style name="DialpadNumberStyle">
        <item name="android:includeFontPadding">false</item>
        <item name="android:textSize">@dimen/dialpad_text_size</item>
    </style>

    <style name="DialpadLetterStyle">
        <item name="android:textSize">@dimen/smaller_text_size</item>
        <item name="android:alpha">0.8</item>
    </style>

    <style name="LetterFastscrollerStyleSmall">
        <item name="android:textSize">@dimen/small_text_size</item>
        <item name="android:alpha">0.8</item>
    </style>

    <style name="LetterFastscrollerStyleTiny">
        <item name="android:textSize">@dimen/tiny_text_size</item>
        <item name="android:alpha">0.8</item>
    </style>

    <style name="LetterFastscrollerStyleTooTiny">
        <item name="android:textSize">@dimen/too_tiny_text_size</item>
        <item name="android:alpha">0.8</item>
    </style>

    <style name="roundedImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

</resources>
