<?xml version="1.0" encoding="utf-8"?>
<!-- Static Liquid Glass surface for list rows and settings cards: frosted white tint, a top
     specular sheen and a hairline rim. Rows scroll with their content, so a live refracting
     LiquidGlassView per row would see a fixed backdrop anyway and only cost frame time. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="@dimen/glass_card_radius" />
            <solid android:color="#2EFFFFFF" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/glass_card_radius" />
            <gradient
                android:angle="270"
                android:centerY="0.35"
                android:startColor="#26FFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/glass_card_radius" />
            <stroke
                android:width="1dp"
                android:color="#59FFFFFF" />
        </shape>
    </item>
</layer-list>
